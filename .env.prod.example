# ── Africa Immo Management — variables de production ────────────────────────────────────
# Copier en `.env` À LA RACINE DU DÉPÔT (lu automatiquement par compose.prod.yml).
# Ne jamais committer le `.env` rempli.
#
#   cp .env.prod.example .env
#   # renseigner ci-dessous, puis :
#   docker compose -f compose.prod.yml build && docker compose -f compose.prod.yml up -d

# ── Domaines (DNS : pointer ces deux A/AAAA vers l'IP du VPS) ─────────────────
APP_DOMAIN=app.mondomaine.tld
API_DOMAIN=api.mondomaine.tld
ACME_EMAIL=admin@mondomaine.tld

# URLs publiques dérivées (https:// + domaines ci-dessus).
# PUBLIC_API_URL est FIGÉE dans le bundle web au build → tout changement =
# `docker compose -f compose.prod.yml build web` obligatoire.
PUBLIC_APP_URL=https://app.mondomaine.tld
PUBLIC_API_URL=https://api.mondomaine.tld

# ── Base de données MySQL (conteneur `db`) ───────────────────────────────────
DB_NAME=lyko_system
DB_USER=lyko
# `openssl rand -base64 24`
DB_PASSWORD=__CHANGER__
DB_ROOT_PASSWORD=__CHANGER__
DB_CONNECTION_LIMIT=10

# ── Authentification JWT ────────────────────────────────────────────────────
# Secrets DISTINCTS, 32 caractères min (refus au démarrage sinon).
# `openssl rand -base64 48`
JWT_ACCESS_SECRET=__CHANGER__
JWT_REFRESH_SECRET=__CHANGER__
# Comptes Quick Immo (clé dédiée) et chiffrement des secrets : obligatoires, 32 caractères min.
JWT_MARKETPLACE_ACCOUNT_SECRET=__CHANGER__
SECRETS_ENCRYPTION_KEY=__CHANGER__
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=lyko-system

# ── Divers ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Courriels (Resend) — obligatoires en production ──────────────────────────
RESEND_API_KEY=__CHANGER__
EMAIL_FROM_ADDRESS=service@cabinetmconseil.com

# ── Abonnements (compte FedaPay de la PLATEFORME) ────────────────────────────
# Laisser SUBSCRIPTIONS_ENFORCED=false tant que le test sandbox n'est pas validé (voir SAAS_DEPLOY.md).
SUBSCRIPTIONS_ENFORCED=false
PLATFORM_FEDAPAY_SECRET_KEY=
PLATFORM_FEDAPAY_WEBHOOK_SECRET=
PLATFORM_FEDAPAY_SANDBOX=true
# Reçoit les demandes de remboursement ET les alertes du suivi des erreurs (back-office, onglet « Erreurs »).
PLATFORM_ADMIN_EMAIL=
# Adresse secrète du back-office : https://<APP_DOMAIN>/<ADMIN_PATH>. Quand elle est définie, /admin répond « introuvable ».
# 10 caractères minimum, minuscules, chiffres et tirets. Générer : openssl rand -hex 8   (ex. gestion-3f9a1c7e2b4d)
# Ne la partagez pas et ne la mettez dans aucun lien public. Changer = redémarrer le conteneur « web ».
ADMIN_PATH=
# Frais retenus en cas de remboursement (en %)
PLATFORM_REFUND_FEE_PERCENT=
# Optionnel : clé dédiée du back-office (sinon dérivée de JWT_ACCESS_SECRET)
PLATFORM_ADMIN_JWT_SECRET=
# Assistant IA désactivé au lancement
ASSISTANT_FEATURE_ENABLED=false

# ── Sauvegardes (deploy/backup-db.sh — voir docs/DEPLOIEMENT.md, section 4) ──
# Phrase secrète de chiffrement, SANS ESPACE : `openssl rand -base64 32`.
# À conserver aussi HORS du serveur — sans elle, les sauvegardes sont illisibles.
BACKUP_PASSPHRASE=
# Destination rclone hors serveur (dossier dédié), ex. b2:africa-immo-backups. Exige BACKUP_PASSPHRASE.
BACKUP_REMOTE=
BACKUP_RETENTION_DAYS=14
BACKUP_REMOTE_RETENTION_DAYS=90

# ── Identité légale de la plateforme (factures d'abonnement, pages légales) ──
PLATFORM_LEGAL_NAME=Africa Immo Management
PLATFORM_LEGAL_RCCM=
PLATFORM_LEGAL_IFU=
PLATFORM_LEGAL_ADDRESS=
TERMS_VERSION=2026-10

# Affichés sur le site (figés au build du service web) — laisser vide = non affiché
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_RCCM=
NEXT_PUBLIC_LEGAL_IFU=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_DIRECTOR=
