{
  "name": "lyko-system",
  "version": "0.1.0",
  "private": true,
  "description": "Lyko System — plateforme multi-tenant de gestion de cabinets immobiliers & juridiques",
  "scripts": {
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "predev": "node scripts/check-dev-not-running.js",
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start:api": "npm --prefix backend start",
    "start:web": "npm --prefix frontend start",
    "db:check": "npm --prefix backend run db:check",
    "db:migrate": "npm --prefix backend run db:migrate",
    "lint": "npm --prefix frontend run lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
