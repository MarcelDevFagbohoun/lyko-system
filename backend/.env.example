# ── Serveur ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Origine(s) autorisée(s) pour CORS (séparées par des virgules)
CORS_ORIGIN=http://localhost:3000
# URL publique de l'application principale (imprimée sur les PDF pour la vérification de document, étape 29)
FRONTEND_URL=http://localhost:3000

# ── Base de données MySQL ─────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lyko
DB_PASSWORD=change-me
DB_NAME=lyko_system
DB_CONNECTION_LIMIT=10

# ── Authentification JWT ──────────────────────────────────
# Secrets DISTINCTS, 32 caractères minimum (refus au démarrage en prod sinon).
# Générer : `openssl rand -base64 48`
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32chars-min
# Comptes Quick Immo (grand public, site externe séparé) : clé DÉDIÉE,
# jamais celle des employés ci-dessus — séparation cryptographique des realms.
JWT_MARKETPLACE_ACCOUNT_SECRET=dev-marketplace-account-secret-change-me-32chars-min
# Access token à durée courte, refresh token long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=lyko-system

# ── Divers ────────────────────────────────────────────────
# Nombre de tours bcrypt pour le hashage des mots de passe
BCRYPT_ROUNDS=12

# ── Chiffrement des secrets (FedaPay) ─────────────────────
# Clé de chiffrement réversible (AES-256-GCM), 32 caractères minimum (refus
# au démarrage en prod sinon) — protège les clés FedaPay de
# chaque entreprise. Générer : `openssl rand -base64 48`
SECRETS_ENCRYPTION_KEY=dev-secrets-encryption-key-change-me-32chars-min

# ── Assistant IA (Claude) ─────────────────────────────────
# Facultatif : sans clé, l'assistant est « non configuré » et le reste de la
# plateforme est inchangé. Clé à créer sur console.anthropic.com ; ne JAMAIS la
# committer. Chaque cabinet doit en plus l'activer lui-même (Réglages, DG).
ANTHROPIC_API_KEY=
# Modèle (décision produit : Sonnet 5 au départ) et profondeur de réflexion.
AI_MODEL=claude-sonnet-5
AI_EFFORT=low
AI_MAX_TOKENS=2048
AI_HISTORY_MESSAGES=12
AI_RETENTION_DAYS=90

# ── Email (Resend) ────────────────────────────────────────
# Obligatoire pour que la vérification d'email à l'inscription (et l'email de bienvenue)
# partent réellement — sans clé, le code est journalisé côté serveur au lieu d'être envoyé
# (dev/test uniquement, jamais en production). Clé à créer sur resend.com ; ne JAMAIS la
# committer.
RESEND_API_KEY=
# Adresse expéditrice — doit appartenir à un domaine vérifié dans Resend.
EMAIL_FROM_ADDRESS=service@cabinetmconseil.com

# ── Abonnements (compte FedaPay de la PLATEFORME) ─────────
# Faux par défaut : toutes les entreprises se comportent comme « interne » (accès complet).
SUBSCRIPTIONS_ENFORCED=false
PLATFORM_FEDAPAY_SECRET_KEY=
PLATFORM_FEDAPAY_WEBHOOK_SECRET=
PLATFORM_FEDAPAY_SANDBOX=true
PLATFORM_ADMIN_EMAIL=
PLATFORM_REFUND_FEE_PERCENT=
# Optionnel : clé dédiée du back-office (sinon dérivée de JWT_ACCESS_SECRET)
PLATFORM_ADMIN_JWT_SECRET=
# Assistant IA : désactivé au lancement
ASSISTANT_FEATURE_ENABLED=false

# ── Identité légale de la plateforme (imprimée sur les factures d'abonnement) ──
PLATFORM_LEGAL_NAME=Africa Immo Management
PLATFORM_LEGAL_RCCM=
PLATFORM_LEGAL_IFU=
PLATFORM_LEGAL_ADDRESS=
# Version des conditions d'utilisation (à changer à chaque modification du texte)
TERMS_VERSION=2026-10
